# Next.js proxies world and attack requests to the Cloudflare authority.
SIEGE_AUTHORITY_URL=http://127.0.0.1:8787
NEXT_PUBLIC_SIEGE_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_SIEGE_WS_URL=ws://127.0.0.1:8787/ws

# Worker-only secrets. Set these with `wrangler secret put` in deployed
# environments, or in cloudflare/.dev.vars for local authority testing.
SESSION_SECRET=replace-with-a-long-random-secret
AUTHORITY_INTERNAL_SECRET=replace-with-a-separate-long-random-secret

# Dodo secrets belong only in the deployment secret store, never in Git.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_ATTACK_PRODUCT_ID=
DODO_DEFENSE_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
