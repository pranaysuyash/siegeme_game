{
  "name": "siegeme",
  "version": "0.1.0",
  "private": true,
  "description": "Siege Me, the persistent public browser siege at siegeme.com",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "authority:dev": "wrangler dev --config cloudflare/wrangler.toml --local --port 8787",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker",
    "typecheck:app": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:harness": "vitest run --config cloudflare/test/vitest.harness.config.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:preferences": "node scripts/browser-preference-smoke.mjs",
    "test:browser:performance": "node scripts/browser-performance-smoke.mjs",
    "test:browser:multiplayer": "node scripts/browser-multiplayer-smoke.mjs",
    "test:browser:isolated": "node scripts/browser-isolated-smoke.mjs",
    "test:browser:attack": "node scripts/browser-attack-flow.mjs",
    "sim:balance": "node scripts/balance-sim.mjs",
    "test:authority": "node scripts/authority-flow-smoke.mjs",
    "test:browser:all": "npm run test:browser && npm run test:browser:preferences && npm run test:browser:performance && npm run test:browser:multiplayer && npm run test:browser:isolated && npm run test:browser:attack"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.0.4",
    "@react-three/rapier": "2.2.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "standardwebhooks": "1.0.0",
    "three": "0.185.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260827.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  }
}
